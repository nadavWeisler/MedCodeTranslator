{
  "name": "med-code-translator",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "build:web": "expo export -p web",
    "refresh:data": "python3 scripts/refresh_medical_db.py --assets-dir data/vocabularies --artifact-dir build/medical-db --report-file build/medical-db/update-report.md",
    "validate:data": "python3 scripts/refresh_medical_db.py --validate-only --allow-missing-crosswalk --allow-missing-icd10-parents --assets-dir data/vocabularies --artifact-dir build/medical-db --report-file build/medical-db/update-report.md",
    "benchmark": "node agents/search-benchmarker/run_benchmark.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~54.0.33",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "fuse.js": "^7.3.0",
    "i18next": "^26.0.10",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.7",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2",
    "@types/jest": "^29.5.12",
    "jest-expo": "~54.0.0",
    "@testing-library/react-native": "^13.2.0"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|fuse\\.js)"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|svg|wasm)$": "<rootDir>/__mocks__/fileMock.js",
      "^@medcode/core$": "<rootDir>/packages/core/src/index.ts",
      "^@medcode/core/(.*)$": "<rootDir>/packages/core/src/$1",
      "^@medcode/search$": "<rootDir>/packages/search/src/index.ts",
      "^@medcode/search/(.*)$": "<rootDir>/packages/search/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  }
}
