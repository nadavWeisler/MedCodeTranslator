{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true,
    "types": ["jest"],
    "paths": {
      "@/db/*": ["./db/*"],
      "@/i18n/*": ["./i18n/*"],
      "@medcode/core": ["./packages/core/src/index.ts"],
      "@medcode/core/*": ["./packages/core/src/*"],
      "@medcode/search": ["./packages/search/src/index.ts"],
      "@medcode/search/*": ["./packages/search/src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
