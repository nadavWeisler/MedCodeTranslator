{
  "name": "med-code-translator",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export -p web",
    "refresh:data": "python scripts/refresh_medical_db.py --assets-dir assets/data --artifact-dir build/medical-db --report-file build/medical-db/update-report.md",
    "validate:data": "python scripts/refresh_medical_db.py --validate-only --allow-missing-crosswalk --assets-dir assets/data --artifact-dir build/medical-db --report-file build/medical-db/update-report.md"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~54.0.33",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "fuse.js": "^7.3.0",
    "i18next": "^26.0.10",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.7",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
